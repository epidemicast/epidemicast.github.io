        <text x="68" y="30">CASES</text>
        <text class="sub" x="68" y="49">testing & reporting</text>
      </g>
      <g transform="translate(62 360)">
        <rect width="230" height="74" rx="16" fill="#fffdf7" stroke="#172421" stroke-opacity=".16" />
        <path d="M22 20c24 7 5 24 30 31M52 20c-24 7-5 24-30 31M28 28h18M26 40h22" fill="none" stroke="#9e3d54" stroke-width="2.6" stroke-linecap="round" />
