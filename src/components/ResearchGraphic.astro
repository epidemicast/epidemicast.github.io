      <filter id="soft-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="10" stdDeviation="15" flood-color="#172421" flood-opacity=".08" />
      </filter>
      <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#006c67" />
      </marker>
    </defs>

    <rect x="16" y="16" width="728" height="528" rx="28" fill="url(#panel-wash)" stroke="#172421" stroke-opacity=".12" />
    <g opacity=".26" stroke="#006c67" fill="none">
