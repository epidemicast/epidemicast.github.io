      </g>
      <g transform="translate(62 170)">
        <rect width="230" height="74" rx="16" fill="#fffdf7" stroke="#172421" stroke-opacity=".16" />
        <path d="M20 49h32M24 41V24h10v17M38 41V18h10v23" fill="none" stroke="#006c67" stroke-width="3" />
