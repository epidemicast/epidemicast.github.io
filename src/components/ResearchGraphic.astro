      <text class="inverse model" x="24" y="69">AI forecasting</text>
      <text class="inverse model" x="24" y="93">models</text>
      <path d="M25 111h130" stroke="#fffdf7" stroke-opacity=".36" />
    </g>

    <g transform="translate(306 410)">
      <rect width="238" height="74" rx="18" fill="#172421" />
      <text class="inverse small-cap" x="23" y="29">THRUST 2</text>
      <text class="inverse label" x="23" y="53">SIMULATED GROUND TRUTH</text>
