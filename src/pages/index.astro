---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import ResearchGraphic from '../components/ResearchGraphic.astro';

const publications = (await getCollection('publications')).filter((publication) => !publication.data.hidden).sort((a, b) => {
  const featuredA = a.data.featured ?? 99;
  const featuredB = b.data.featured ?? 99;
  return featuredA - featuredB || b.data.year - a.data.year || a.data.title.localeCompare(b.data.title);
});
const featured = publications.filter((publication) => publication.data.featured).slice(0, 4);
const awardPublication = publications.find((publication) => publication.id.replace(/\.md$/, '') === 'mobility-location-bias-correction');
const people = (await getCollection('people')).sort((a, b) => {
  const groupOrder = { lead: 0, investigator: 1 };
  return groupOrder[a.data.group] - groupOrder[b.data.group] || a.data.name.localeCompare(b.data.name);
});
const talks = await getCollection('talks');
const assetPath = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path}`;

const nameAliases = new Map([
  ['chandini raina macintyre', 'raina macintyre'],
  ['c raina macintyre', 'raina macintyre'],
  ['raina macintyre', 'raina macintyre'],
  ['flora d salim', 'flora salim'],
  ['david j heslop', 'david heslop'],
]);
const normalizePersonName = (name: string) => {
  const normalized = name
    .normalize('NFKD')
    .replace(/\p{M}/gu, '')
    .toLocaleLowerCase('en')
    .replace(/[^a-z\s-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return nameAliases.get(normalized) ?? normalized;
};

const keyTeamMembers = [
  { name: 'Jing Du', affiliation: 'UNSW Sydney', expertise: 'Graph representation learning, spatiotemporal modelling, and trustworthy AI' },
  { name: 'Yonchanok Khaokaew', affiliation: 'UNSW Sydney', expertise: 'Large language models, human-centred computing, and wearable computing' },
  { name: 'Ruochen Kong', affiliation: 'Emory University', expertise: 'Infectious-disease simulation, data bias, and machine learning' },
  { name: 'Owen Tucker', affiliation: 'Emory University', expertise: 'Human mobility, spatial inference, and data privacy' },
  { name: 'Haley Stone', affiliation: 'UNSW Sydney', expertise: 'Epidemic modelling, machine learning, and computational biology' },
  { name: 'Yang Yang', affiliation: 'UNSW Sydney', expertise: 'Spatiotemporal graph learning and epidemic forecasting' },
  { name: 'Ashna Desai', affiliation: 'UNSW Sydney', expertise: 'Spatiotemporal epidemic forecasting and graph learning' },
  { name: 'Toan Tran', affiliation: 'Emory University', expertise: 'Machine learning, data privacy, and human-mobility modelling' },
].sort((a, b) => a.name.localeCompare(b.name));
const coreNames = new Set(people.map((person) => normalizePersonName(person.data.name)));
const keyTeamNames = new Set(keyTeamMembers.map((member) => normalizePersonName(member.name)));
const contributorExclusions = new Set(['Kacper Sokol', 'Hye-Young Paik'].map(normalizePersonName));
const contributorNames = new Map<string, string>();
for (const name of publications.flatMap((publication) => publication.data.authors)) {
  const identity = normalizePersonName(name);
  if (!coreNames.has(identity) && !keyTeamNames.has(identity) && !contributorExclusions.has(identity) && !contributorNames.has(identity)) contributorNames.set(identity, name);
}
const contributors = [...contributorNames.values()].sort((a, b) => a.localeCompare(b));

const thrusts = [
  {
    number: '01',
    title: 'Spatiotemporal AI for disease-spread prediction',
    text: 'We develop transferable models that learn from heterogeneous and sparsely labelled signals, including human mobility, confirmed cases, pathogen genomics and phylogenetics, ecological context, and auxiliary open-source data.',
    methods: ['Spatiotemporal learning', 'Heterogeneous graphs', 'Phylogenetics', 'Causal inference'],
  },
  {
    number: '02',
    title: 'Agent-based simulation for understanding bias',
    text: 'We build scalable synthetic populations and disease-spread simulations that provide complete ground truth alongside observable datasets collected under controlled bias.',
    methods: ['Agent-based modelling', 'Synthetic mobility', 'Contact networks', 'Differential privacy'],
  },
  {
    number: '03',
    title: 'Measuring, mitigating, and correcting bias',
    text: 'We connect the simulated sandbox to predictive models to study how known biases affect performance across regions and populations and to evaluate correction strategies throughout the modelling pipeline.',
    methods: ['Fairness evaluation', 'Bias correction', 'Robustness', 'Explainability'],
  },
];

const resourceCards = [
  { kind: 'Dataset and benchmark', title: 'Controlled-bias infectious-disease datasets', text: 'Ground-truth and observable-data pairs for evaluating how collection bias propagates through predictive models.', links: [] },
  { kind: 'Simulation', title: 'EpiScale', text: 'Large-scale, mobility-informed infrastructure for simulating infectious-disease spread across realistic urban populations.', links: [
    { label: 'GitHub', url: 'https://github.com/RuochenKong/Compartmental-Infectious-Disease-Simulation' },
  ] },
  { kind: 'Model family', title: 'Heterogeneous outbreak forecasting', text: 'Graph-learning methods that connect ecological, mobility, genomic and epidemiological signals.', links: [
    { label: 'GitHub', url: 'https://github.com/cruiseresearchgroup/BLUE' },
    { label: 'Hugging Face', url: 'https://huggingface.co/datasets/CRUISEResearchGroup/Avian-US_dataset' },
  ] },
  { kind: 'Dataset', title: 'Urban Anomalies', text: 'Simulated human mobility with controlled, labelled anomalies for reproducible stress-testing.', links: [] },
];

const partnerGroups = [
  {
    id: 'funding-partners',
    label: 'Funded by',
    kind: 'funders',
    logos: [
      { name: 'U.S. National Science Foundation', src: assetPath('partners/nsf.png'), width: 166, height: 166 },
      { name: 'CSIRO', src: assetPath('partners/csiro.png'), width: 164, height: 166 },
    ],
  },
  {
    id: 'academic-partners',
    label: 'Academic partners',
    kind: 'institutions',
    logos: [
      { name: 'UNSW Sydney', src: assetPath('partners/unsw-sydney.png'), width: 208, height: 90, dark: true },
      { name: 'George Mason University', src: assetPath('partners/george-mason-university.png'), width: 198, height: 232, tall: true },
      { name: 'Emory University', src: assetPath('partners/emory-university.png'), width: 240, height: 136 },
      { name: 'Arizona State University', src: assetPath('partners/arizona-state-university.png'), width: 198, height: 152 },
    ],
  },
];

const description = 'An Australia–United States research collaboration developing fair and trustworthy AI for forecasting infectious disease spread.';
---

<BaseLayout title="Understanding Bias in AI Models for Infectious Disease Spread" description={description}>
  <header class="site-header" data-site-header>
    <div class="header-inner shell">
      <a class="brand" href="#top" aria-label="Project home">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>Understanding Bias in AI Models<br />for Infectious Disease Spread</span>
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-button>
        <span>Menu</span><i aria-hidden="true"></i>
      </button>
      <nav id="primary-navigation" class="primary-nav" aria-label="Primary navigation" data-primary-nav>
        <a href="#research">Research</a>
        <a href="#publications">Publications</a>
        <a href="#resources">Resources</a>
        <a href="#talks">Talks and Events</a>
        <a href="#people">People</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" id="top">
      <div class="hero-grid shell">
        <div class="hero-copy reveal">
          <p class="eyebrow">NSF–CSIRO Collaborative Research Project</p>
          <h1>Fair and trustworthy AI for forecasting <em>infectious disease spread.</em></h1>
          <p class="hero-intro">We examine how biases in mobility, demographic, case-reporting, and pathogen-genomic data shape epidemic forecasts. We also develop learning methods and simulation environments to measure, mitigate, and correct their effects.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#research">Explore the research <span aria-hidden="true">↓</span></a>
            <a class="button button-text" href="#publications">View publications <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hero-visual reveal reveal-delay">
          <ResearchGraphic />
        </div>
      </div>
      <div class="partner-band shell reveal" aria-label="Project funders and academic partners">
        {partnerGroups.map((group) => (
          <div class:list={['partner-group', `partner-group-${group.kind}`]} role="group" aria-labelledby={group.id}>
            <p class="partner-group-label" id={group.id}>{group.label}</p>
            <div class="partner-logo-grid">
              {group.logos.map((logo) => (
                <div class:list={['partner-logo-cell', { 'partner-logo-cell-dark': logo.dark, 'partner-logo-cell-tall': logo.tall }]}>
                  <img src={logo.src} width={logo.width} height={logo.height} alt={logo.name} decoding="async" />
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      {awardPublication && (
        <aside class="award-highlight shell reveal" aria-labelledby="award-highlight-title">
          <div class="award-emblem" aria-hidden="true">
            <span>2026</span>
            <strong>Runner-Up</strong>
          </div>
          <div class="award-copy">
            <p>ACM SIGSPATIAL · Application Track</p>
            <h2 id="award-highlight-title">Best Paper Runner-Up</h2>
            <span>{awardPublication.data.title}</span>
          </div>
          <a class="award-action" href="#publication-mobility-location-bias-correction">
            View publication <span aria-hidden="true">↓</span>
          </a>
        </aside>
      )}
      <div class="hero-facts shell" aria-label="Project facts">
        <div><strong>3</strong><span>connected research thrusts</span></div>
        <div><strong>{publications.length}</strong><span>research outputs</span></div>
        <div><strong>4</strong><span>critical data streams</span></div>
        <p>Australia ↔ United States</p>
      </div>
    </section>

    <section class="section challenge" aria-labelledby="challenge-title">
      <div class="shell section-grid">
        <header class="section-heading reveal">
          <p class="eyebrow">Why this matters</p>
          <h2 id="challenge-title">Better forecasts require a clearer view of bias.</h2>
        </header>
        <div class="challenge-copy reveal">
          <p class="lead">Infectious-disease forecasting increasingly relies on data that are incomplete by design and in practice.</p>
          <div class="prose-columns">
            <p>Access to testing varies. Mobility samples represent only part of the population. Census participation is uneven. Pathogen sequencing is geographically imbalanced. When these gaps propagate unnoticed through an AI pipeline, they can produce unreliable forecasts and inequitable decisions.</p>
            <p>By comparing complete simulated ground truth with realistically biased observations, we can trace how biases enter a model, quantify their effects, and evaluate strategies for building fairer, more robust forecasting systems.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section research" id="research" aria-labelledby="research-title">
      <div class="shell">
        <header class="section-heading section-heading-wide reveal">
          <p class="eyebrow">Research programme</p>
          <h2 id="research-title">Three connected thrusts,<br />from prediction to correction.</h2>
        </header>
        <div class="thrust-grid">
          {thrusts.map((thrust) => (
            <article class="thrust-card reveal">
              <span class="thrust-number">{thrust.number}</span>
              <h3>{thrust.title}</h3>
              <p>{thrust.text}</p>
              <ul>
                {thrust.methods.map((method) => <li>{method}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <div class="program-flow reveal" aria-label="Research process">
          <div><span>01</span><strong>Ground-truth world</strong><small>Complete synthetic population</small></div>
          <i aria-hidden="true">→</i>
          <div><span>02</span><strong>Biased observations</strong><small>Sampling, reporting, privacy</small></div>
          <i aria-hidden="true">→</i>
          <div><span>03</span><strong>Forecasting models</strong><small>Learning across signals</small></div>
          <i aria-hidden="true">→</i>
          <div><span>04</span><strong>Measure and correct</strong><small>Fairness, robustness, and trust</small></div>
        </div>
      </div>
    </section>

    <section class="section latest" aria-labelledby="latest-title">
      <div class="shell">
        <header class="section-heading section-heading-inline reveal">
          <div>
            <p class="eyebrow">Featured work</p>
            <h2 id="latest-title">Recent research across the programme.</h2>
          </div>
          <a class="text-link" href="#publications">All publications <span aria-hidden="true">↓</span></a>
        </header>
        <div class="featured-grid">
          {featured.map((publication, index) => (
            <article class:list={['featured-card', { 'featured-card-lead': index === 0 }, 'reveal']}>
              {publication.data.visual && (
                <figure class="featured-visual">
                  <img
                    src={assetPath(publication.data.visual.src)}
                    alt={publication.data.visual.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{publication.data.visual.caption}</figcaption>
                </figure>
              )}
              <div class="featured-copy">
                <div class="featured-meta"><span>Thrust {publication.data.thrust}</span><span>{publication.data.year}</span></div>
                <h3>{publication.data.title}</h3>
                <p>{publication.data.summary}</p>
                <div class="featured-footer">
                  <span>{publication.data.venue}</span>
                  {publication.data.links.paper && <a href={publication.data.links.paper} target="_blank" rel="noreferrer" aria-label={`Open paper: ${publication.data.title}`}>Open paper ↗</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section publications" id="publications" aria-labelledby="publications-title">
      <div class="shell">
        <header class="section-heading section-heading-wide reveal">
          <p class="eyebrow">Publications</p>
          <h2 id="publications-title">Methods, systems, and evidence.</h2>
        </header>
        <PublicationList publications={publications} />
      </div>
    </section>

    <section class="section resources" id="resources" aria-labelledby="resources-title">
      <div class="shell">
        <header class="section-heading section-heading-inline reveal">
          <div>
            <p class="eyebrow">Open resources</p>
            <h2 id="resources-title">Code, data, and reproducible research.</h2>
          </div>
          <p class="heading-note">Repository links are maintained for individual publications and added once confirmed.</p>
        </header>
        <div class="resource-grid">
          {resourceCards.map((resource, index) => (
            <article class="resource-card reveal">
              <span class="resource-kind">{resource.kind}</span>
              <span class="resource-index" aria-hidden="true">0{index + 1}</span>
              <h3>{resource.title}</h3>
              <p>{resource.text}</p>
              {resource.links.length > 0 ? (
                <div class="resource-links" aria-label={`Links for ${resource.title}`}>
                  {resource.links.map((link) => <a href={link.url} target="_blank" rel="noreferrer">{link.label}<span aria-hidden="true"> ↗</span></a>)}
                </div>
              ) : <span class="resource-status">Repository details forthcoming</span>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section talks" id="talks" aria-labelledby="talks-title">
      <div class="shell section-grid">
        <header class="section-heading reveal">
          <p class="eyebrow">Talks and events</p>
          <h2 id="talks-title">From research to public health practice.</h2>
        </header>
        <div class="talk-list reveal">
          {talks.map((talk) => (
            <article class="talk-card">
              <div class="talk-date"><span>{talk.data.type}</span>{talk.data.date}</div>
              <h3>{talk.data.title}</h3>
              <p>{talk.data.summary}</p>
              <footer>
                <span>{talk.data.location}</span>
                {talk.data.links.event || talk.data.links.slides || talk.data.links.video ? (
                  <div class="talk-links" aria-label={`Links for ${talk.data.title}`}>
                    {talk.data.links.event && <a href={talk.data.links.event} target="_blank" rel="noreferrer">Event page <span aria-hidden="true">↗</span></a>}
                    {talk.data.links.slides && <a href={talk.data.links.slides} target="_blank" rel="noreferrer">Slides <span aria-hidden="true">↗</span></a>}
                    {talk.data.links.video && <a href={talk.data.links.video} target="_blank" rel="noreferrer">Watch on YouTube <span aria-hidden="true">↗</span></a>}
                  </div>
                ) : <span class="links-pending">Event media forthcoming</span>}
              </footer>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section people" id="people" aria-labelledby="people-title">
      <div class="shell">
        <header class="section-heading section-heading-wide reveal">
          <p class="eyebrow">People</p>
          <h2 id="people-title">An interdisciplinary Australia–U.S. collaboration.</h2>
          <p>Our team brings together computer scientists, simulation modellers, public health researchers, and epidemiologists working across the full forecasting pipeline.</p>
        </header>

        <h3 class="group-label">Project leads</h3>
        <div class="people-grid people-grid-leads">
          {people.filter((person) => person.data.group === 'lead').map((person) => (
            <article class="person-card person-card-lead reveal">
              <span class="person-avatar" aria-hidden="true">{person.data.initials}</span>
              <div><h4>{person.data.name}</h4><p>{person.data.role}</p><span>{person.data.expertise}</span>{person.data.affiliation && <small>{person.data.affiliation}</small>}</div>
            </article>
          ))}
        </div>

        <h3 class="group-label">Investigators</h3>
        <div class="people-grid people-grid-investigators">
          {people.filter((person) => person.data.group === 'investigator').map((person) => (
            <article class="person-card reveal">
              <span class="person-avatar" aria-hidden="true">{person.data.initials}</span>
              <div><h4>{person.data.name}</h4><p>{person.data.expertise}</p>{person.data.affiliation && <small>{person.data.affiliation}</small>}</div>
            </article>
          ))}
        </div>

        <h3 class="group-label">Key team members</h3>
        <div class="people-grid people-grid-key-team">
          {keyTeamMembers.map((member) => (
            <article class="person-card person-card-key-team reveal">
              <span class="person-avatar" aria-hidden="true">{member.name.split(' ').map((part) => part[0]).join('')}</span>
              <div><h4>{member.name}</h4><p>{member.expertise}</p><small>{member.affiliation}</small></div>
            </article>
          ))}
        </div>

        <div class="contributors reveal">
          <h3>Contributors</h3>
          <p>{contributors.join(' · ')}</p>
        </div>

      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div>
        <p class="eyebrow">NSF–CSIRO Collaborative Research Project</p>
        <h2>Understanding Bias in AI Models for the Prediction of Infectious Disease Spread</h2>
      </div>
      <p>We develop accurate, scalable, and equitable AI methods for infectious-disease forecasting through prediction, simulation, and bias correction.</p>
      <div class="footer-links">
        <a href="#research">Research</a><a href="#publications">Publications</a><a href="#people">People</a>
        <span>Project contacts</span>
        <a href="mailto:azufle@emory.edu">Andreas Züfle: azufle@emory.edu</a>
        <a href="mailto:flora.salim@unsw.edu.au">Flora D. Salim: flora.salim@unsw.edu.au</a>
      </div>
    </div>
    <div class="shell footer-bottom"><span>Australia–United States research collaboration</span></div>
  </footer>

  <script>
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const navigation = document.querySelector<HTMLElement>('[data-primary-nav]');
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      navigation?.classList.toggle('is-open', !open);
    });
    navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      navigation.classList.remove('is-open');
    }));

    const revealItems = document.querySelectorAll<HTMLElement>('.reveal');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -35px' });
      revealItems.forEach((item) => observer.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    }
  </script>
</BaseLayout>
