---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import ResearchGraphic from '../components/ResearchGraphic.astro';

const publications = (await getCollection('publications')).sort((a, b) => {
  const featuredA = a.data.featured ?? 99;
  const featuredB = b.data.featured ?? 99;
  return featuredA - featuredB || b.data.year - a.data.year || a.data.title.localeCompare(b.data.title);
});
const featured = publications.filter((publication) => publication.data.featured).slice(0, 4);
const people = (await getCollection('people')).sort((a, b) => {
  const groupOrder = { lead: 0, investigator: 1 };
  return groupOrder[a.data.group] - groupOrder[b.data.group] || a.data.name.localeCompare(b.data.name);
});
const talks = await getCollection('talks');
const coreNames = new Set(people.map((person) => person.data.name.replace('C. ', '').replace('D. ', '')));
const contributors = [...new Set(publications.flatMap((publication) => publication.data.authors))]
  .filter((name) => !coreNames.has(name.replace('C. ', '').replace('D. ', '').replace('Flora D. Salim', 'Flora Salim')))
  .sort((a, b) => a.localeCompare(b));

const thrusts = [
  {
    number: '01',
    title: 'Spatiotemporal AI for disease-spread prediction',
    text: 'We develop transferable models that learn from heterogeneous and sparsely labelled signals, including human mobility, confirmed cases, pathogen genomics and phylogenetics, ecological context, and auxiliary open-source data.',
    methods: ['Spatiotemporal learning', 'Heterogeneous graphs', 'Phylogenetics', 'Causal inference'],
  },
  {
    number: '02',
    title: 'Agent-based simulation for understanding bias',
    text: 'We build scalable synthetic populations and disease-spread simulations that provide complete ground truth alongside observable datasets collected under controlled bias.',
    methods: ['Agent-based modelling', 'Synthetic mobility', 'Contact networks', 'Differential privacy'],
  },
  {
    number: '03',
    title: 'Measuring, mitigating and correcting bias',
    text: 'We connect the simulated sandbox to predictive models to study how known biases affect performance across regions and populations—and evaluate correction strategies throughout the modelling pipeline.',
    methods: ['Fairness evaluation', 'Bias correction', 'Robustness', 'Explainability'],
  },
];

const resourceCards = [
  { kind: 'Dataset & benchmark', title: 'Controlled-bias infectious-disease datasets', text: 'Ground-truth and observable-data pairs for evaluating how collection bias propagates through predictive models.' },
  { kind: 'Simulation', title: 'EpiScale', text: 'Large-scale, mobility-informed infrastructure for simulating infectious-disease spread across realistic urban populations.' },
  { kind: 'Model family', title: 'Heterogeneous outbreak forecasting', text: 'Graph-learning methods that connect ecological, mobility, genomic and epidemiological signals.' },
  { kind: 'Dataset', title: 'Urban Anomalies', text: 'Simulated human mobility with controlled, labelled anomalies for reproducible stress-testing.' },
];

const partners = ['CSIRO', 'U.S. National Science Foundation', 'UNSW Sydney', 'George Mason University', 'Emory University', 'Arizona State University'];
const description = 'An Australia–United States research collaboration developing fair and trustworthy AI for forecasting infectious disease spread.';
---

<BaseLayout title="Understanding Bias in AI Models for Infectious Disease Spread" description={description}>
  <header class="site-header" data-site-header>
    <div class="header-inner shell">
      <a class="brand" href="#top" aria-label="Project home">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>Understanding Bias in AI Models<br />for Infectious Disease Spread</span>
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-button>
        <span>Menu</span><i aria-hidden="true"></i>
      </button>
      <nav id="primary-navigation" class="primary-nav" aria-label="Primary navigation" data-primary-nav>
        <a href="#research">Research</a>
        <a href="#publications">Publications</a>
        <a href="#resources">Resources</a>
        <a href="#talks">Talks & Events</a>
        <a href="#people">People</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" id="top">
      <div class="hero-grid shell">
        <div class="hero-copy reveal">
          <p class="eyebrow">NSF–CSIRO Collaborative Research Project</p>
          <h1>Fair and trustworthy AI for forecasting <em>infectious disease spread.</em></h1>
          <p class="hero-intro">We study how bias in mobility, demographic, case-reporting and pathogen-genomics data shapes epidemic forecasts—and develop learning methods and simulation environments to measure, mitigate and correct its effects.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#research">Explore the research <span aria-hidden="true">↓</span></a>
            <a class="button button-text" href="#publications">View publications <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hero-visual reveal reveal-delay">
          <ResearchGraphic />
        </div>
      </div>
      <div class="hero-facts shell" aria-label="Project facts">
        <div><strong>3</strong><span>connected research thrusts</span></div>
        <div><strong>{publications.length}</strong><span>research outputs</span></div>
        <div><strong>4</strong><span>critical data streams</span></div>
        <p>Australia ↔ United States</p>
      </div>
    </section>

    <section class="section challenge" aria-labelledby="challenge-title">
      <div class="shell section-grid">
        <header class="section-heading reveal">
          <p class="eyebrow">Why this matters</p>
          <h2 id="challenge-title">Better forecasts require a clearer view of bias.</h2>
        </header>
        <div class="challenge-copy reveal">
          <p class="lead">Infectious-disease forecasting increasingly relies on data that are incomplete by design and in practice.</p>
          <div class="prose-columns">
            <p>Access to testing varies. Mobility samples represent only part of the population. Census participation is uneven. Pathogen sequencing is geographically imbalanced. When these gaps pass unnoticed through an AI pipeline, they can produce unreliable forecasts and inequitable decisions.</p>
            <p>By comparing complete simulation ground truth with realistically biased observations, we can trace how bias enters a model, quantify its effects, and evaluate strategies for building fairer and more robust forecasting systems.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section research" id="research" aria-labelledby="research-title">
      <div class="shell">
        <header class="section-heading section-heading-wide reveal">
          <p class="eyebrow">Research program</p>
          <h2 id="research-title">Three connected thrusts,<br />from prediction to correction.</h2>
        </header>
        <div class="thrust-grid">
          {thrusts.map((thrust) => (
            <article class="thrust-card reveal">
              <span class="thrust-number">{thrust.number}</span>
              <h3>{thrust.title}</h3>
              <p>{thrust.text}</p>
              <ul>
                {thrust.methods.map((method) => <li>{method}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <div class="program-flow reveal" aria-label="Research process">
          <div><span>01</span><strong>Ground-truth world</strong><small>Complete synthetic population</small></div>
          <i aria-hidden="true">→</i>
          <div><span>02</span><strong>Biased observations</strong><small>Sampling, reporting, privacy</small></div>
          <i aria-hidden="true">→</i>
          <div><span>03</span><strong>Forecasting models</strong><small>Learning across signals</small></div>
          <i aria-hidden="true">→</i>
          <div><span>04</span><strong>Measure & correct</strong><small>Fairness, robustness, trust</small></div>
        </div>
      </div>
    </section>

    <section class="section latest" aria-labelledby="latest-title">
      <div class="shell">
        <header class="section-heading section-heading-inline reveal">
          <div>
            <p class="eyebrow">Featured work</p>
            <h2 id="latest-title">Recent research across the program.</h2>
          </div>
          <a class="text-link" href="#publications">All publications <span aria-hidden="true">↓</span></a>
        </header>
        <div class="featured-grid">
          {featured.map((publication, index) => (
            <article class:list={['featured-card', { 'featured-card-lead': index === 0 }, 'reveal']}>
              <div class="featured-meta"><span>Thrust {publication.data.thrust}</span><span>{publication.data.year}</span></div>
              <h3>{publication.data.title}</h3>
              <p>{publication.data.summary}</p>
              <div class="featured-footer">
                <span>{publication.data.venue}</span>
                {publication.data.links.paper && <a href={publication.data.links.paper} target="_blank" rel="noreferrer" aria-label={`Open paper: ${publication.data.title}`}>Open paper ↗</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section publications" id="publications" aria-labelledby="publications-title">
      <div class="shell">
        <header class="section-heading section-heading-wide reveal">
          <p class="eyebrow">Publications</p>
          <h2 id="publications-title">Methods, systems and evidence.</h2>
          <p>Publication statuses and links reflect the May 2026 project report. Submitted work and repository links will be updated after confirmation.</p>
        </header>
        <PublicationList publications={publications} />
      </div>
    </section>

    <section class="section resources" id="resources" aria-labelledby="resources-title">
      <div class="shell">
        <header class="section-heading section-heading-inline reveal">
          <div>
            <p class="eyebrow">Open resources</p>
            <h2 id="resources-title">Code, data and reproducible research.</h2>
          </div>
          <p class="heading-note">Repository links are maintained per publication and will appear here when confirmed.</p>
        </header>
        <div class="resource-grid">
          {resourceCards.map((resource, index) => (
            <article class="resource-card reveal">
              <span class="resource-kind">{resource.kind}</span>
              <span class="resource-index" aria-hidden="true">0{index + 1}</span>
              <h3>{resource.title}</h3>
              <p>{resource.text}</p>
              <span class="resource-status">Repository details forthcoming</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section talks" id="talks" aria-labelledby="talks-title">
      <div class="shell section-grid">
        <header class="section-heading reveal">
          <p class="eyebrow">Talks & events</p>
          <h2 id="talks-title">From research to public-health practice.</h2>
        </header>
        <div class="talk-list reveal">
          {talks.map((talk) => (
            <article class="talk-card">
              <div class="talk-date"><span>{talk.data.type}</span>{talk.data.date}</div>
              <h3>{talk.data.title}</h3>
              <p>{talk.data.summary}</p>
              <footer>
                <span>{talk.data.location}</span>
                <span class="links-pending">Event media forthcoming</span>
              </footer>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section people" id="people" aria-labelledby="people-title">
      <div class="shell">
        <header class="section-heading section-heading-wide reveal">
          <p class="eyebrow">People</p>
          <h2 id="people-title">An interdisciplinary Australia–US collaboration.</h2>
          <p>Computer scientists, simulation modellers, public-health researchers and epidemiologists working across the full forecasting pipeline.</p>
        </header>

        <h3 class="group-label">Project leads</h3>
        <div class="people-grid people-grid-leads">
          {people.filter((person) => person.data.group === 'lead').map((person) => (
            <article class="person-card person-card-lead reveal">
              <span class="person-avatar" aria-hidden="true">{person.data.initials}</span>
              <div><h4>{person.data.name}</h4><p>{person.data.role}</p><span>{person.data.expertise}</span><small>{person.data.affiliation}</small></div>
            </article>
          ))}
        </div>

        <h3 class="group-label">Investigators</h3>
        <div class="people-grid">
          {people.filter((person) => person.data.group === 'investigator').map((person) => (
            <article class="person-card reveal">
              <span class="person-avatar" aria-hidden="true">{person.data.initials}</span>
              <div><h4>{person.data.name}</h4><p>{person.data.expertise}</p><small>{person.data.affiliation}</small></div>
            </article>
          ))}
        </div>

        <div class="contributors reveal">
          <h3>Contributors</h3>
          <p>{contributors.join(' · ')}</p>
        </div>

        <div class="partners reveal">
          <p class="eyebrow">Funders & partner institutions</p>
          <div class="partner-list">
            {partners.map((partner) => <span>{partner}</span>)}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div>
        <p class="eyebrow">NSF–CSIRO Collaborative Research Project</p>
        <h2>Understanding Bias in AI Models for the Prediction of Infectious Disease Spread</h2>
      </div>
      <p>Developing accurate, scalable and equitable AI methods for infectious-disease forecasting through prediction, simulation and bias correction.</p>
      <div class="footer-links">
        <a href="#research">Research</a><a href="#publications">Publications</a><a href="#people">People</a>
        <span>Project contact: <strong>[To confirm]</strong></span>
      </div>
    </div>
    <div class="shell footer-bottom"><span>Australia–United States research collaboration</span><span>Content updated from the May 2026 project report</span></div>
  </footer>

  <script>
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const navigation = document.querySelector<HTMLElement>('[data-primary-nav]');
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!open));
      navigation?.classList.toggle('is-open', !open);
    });
    navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      navigation.classList.remove('is-open');
    }));

    const revealItems = document.querySelectorAll<HTMLElement>('.reveal');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -35px' });
      revealItems.forEach((item) => observer.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    }
  </script>
</BaseLayout>
